# CodePulse environment variables (safe example - do not put real secrets here)
#
# BACKEND (all modules):
#   NODE_ENV      - development | test | production (default: development)
#   PORT          - backend HTTP port (default: 5000)
#   FRONTEND_URL  - allowed CORS origin for local frontend (default: http://localhost:3000)
#   DATABASE_URL  - REQUIRED since Module 1: PostgreSQL connection string.
#                   The backend boots without it, but every database-backed
#                   endpoint returns 503 until it is configured.
#   JWT_SECRET    - REQUIRED in production (>= 32 chars). In development a
#                   dev-only insecure default is used with a startup warning.
#                   Leave empty here; put the real value only in .env.
#   *_TIMEOUT_MS  - upstream HTTP timeouts in ms (default 10000 each).
#                   No platform passwords or API keys are used: all five
#                   integrations read public data only.
#
# DOCKER POSTGRES (used by compose.yaml - real values go only in .env):
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT
#
# FRONTEND:
#   NEXT_PUBLIC_API_URL - public backend origin for the browser
#                   (default: http://localhost:3000 -> http://localhost:5000).
#                   Set in frontend/.env.local; never put secrets in NEXT_PUBLIC_*.
#
# Local PostgreSQL via the documented Docker Compose setup
# (compose.yaml + root .env hold the real values; never commit them):
#   DATABASE_URL=postgresql://codepulse:<POSTGRES_PASSWORD>@localhost:5432/codepulse

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://codepulse:CHANGEME@localhost:5432/codepulse
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjMiLCJuYW1lIjoiVXNlciIsImlhdCI6MTc5MTc5MDI3MjkzMH0.iSbtICwhNC_uWOwcvpZdUiED6IWM07ZIewWBLZS6A7A
CODEFORCES_TIMEOUT_MS=10000
LEETCODE_TIMEOUT_MS=10000
CODECHEF_TIMEOUT_MS=10000
GEEKSFORGEEKS_TIMEOUT_MS=10000
HACKERRANK_TIMEOUT_MS=10000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Docker Compose PostgreSQL (compose.yaml reads these from the root .env).
# POSTGRES_PASSWORD must match the password inside DATABASE_URL.
POSTGRES_USER=codepulse
POSTGRES_PASSWORD=
POSTGRES_DB=codepulse
POSTGRES_PORT=5432